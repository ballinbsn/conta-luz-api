# ===== Copie para .env (local) ou cadastre em Railway > Variables =====

# --- Adex (obrigatório) --- Painel Adex > Configurações > Chaves API
ADEX_PUBLIC_KEY=pk_live_COLE_AQUI
ADEX_SECRET_KEY=sk_live_COLE_AQUI
# Segredo de assinatura do webhook (se a Adex mostrar um ao criar o webhook). Se vazio, usa a ADEX_SECRET_KEY.
ADEX_WEBHOOK_SECRET=
ADEX_BASE_URL=https://api.adex.cash/functions/v1
# "reais" (padrão) ou "centavos". Confirme com: npm run smoke:adex
ADEX_AMOUNT_UNIT=reais

# --- Banco de dados (obrigatório em produção) ---
# No Railway: + New > Database > PostgreSQL. Depois, no serviço da API, Variables > Add Reference > DATABASE_URL
DATABASE_URL=

# --- Endereço público desta API (usado como postbackUrl do PIX) ---
# Railway preenche RAILWAY_PUBLIC_DOMAIN sozinho ao gerar o domínio; só defina PUBLIC_URL se usar domínio próprio.
PUBLIC_URL=

# --- Painel de pedidos (GET /api/admin/orders) --- gere algo longo e aleatório
ADMIN_TOKEN=

# --- Funil e loja ---
# URL do funil (onde estão /politicas/, /termos/, /devolucao/). Ex.: https://seudominio.com
FUNNEL_URL=
STORE_NAME=EcoVolt
SUPPORT_EMAIL=contato@naturalli.shop
SUPPORT_PHONE=+55 (11) 4004-2812

# --- Utmify (vendas com origem de campanha) --- Utmify > Integrações > Webhooks > Credenciais de API
UTMIFY_API_TOKEN=
# true = a Utmify valida o envio mas NÃO salva (use na 1ª vez; depois apague esta variável)
UTMIFY_TEST=false
UTMIFY_PLATFORM=EcoVolt

# --- Opcionais ---
PIX_EXPIRES_MINUTES=30
# Domínios do funil que podem chamar /api (CORS), separados por vírgula. Vazio = só mesma origem.
CORS_ORIGIN=
# Exigir assinatura HMAC em todo webhook (ative depois de validar que a Adex assina)
REQUIRE_WEBHOOK_SIGNATURE=false
NODE_ENV=production
